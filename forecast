from datetime import datetime, timedelta
from data import revenue_data


def calculate_forecast(days_ahead=7):
    """
    Простой прогноз выручки на основе средней дневной выручки
    """

    total_revenue = sum(item.revenue for item in revenue_data)
    total_orders = sum(item.orders for item in revenue_data)

    days_count = len(revenue_data)

    if days_count == 0:
        return {
            "forecast": [],
            "message": "No data available"
        }

    average_revenue = total_revenue / days_count
    average_orders = total_orders / days_count

    forecast = []

    last_day = datetime.strptime(
        revenue_data[-1].day,
        "%Y-%m-%d"
    )

    for i in range(1, days_ahead + 1):

        future_date = last_day + timedelta(days=i)

        forecast.append({
            "day": future_date.strftime("%Y-%m-%d"),
            "predicted_revenue": round(average_revenue, 2),
            "predicted_orders": round(average_orders)
        })

    return {
        "average_daily_revenue": round(average_revenue, 2),
        "average_daily_orders": round(average_orders, 2),
        "forecast_days": days_ahead,
        "forecast": forecast
    }
